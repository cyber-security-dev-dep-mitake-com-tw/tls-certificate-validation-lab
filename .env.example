# Change to a reserved subdomain under a domain you control; no public DNS needed.
LAB_DOMAIN=tls-lab.example.test

# Linux/macOS: use `id -u` and `id -g`; these let SVC2 write to ./reports.
# Windows Docker Desktop: default usually works; adjust if bind-mount permissions differ.
HOST_UID=1000
HOST_GID=1000
